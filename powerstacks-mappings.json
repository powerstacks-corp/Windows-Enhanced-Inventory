    "identityRules": [
      { "id": "ps-own-msi", "type": "ownership", "source": "msi", "description": "A file that Windows Installer records as a component of an installed product maps to that product." },
      { "id": "ps-own-store", "type": "ownership", "source": "store", "description": "A Store package maps to the installed package." },
      { "id": "ps-arp-compare", "type": "arpCompare", "description": "A file whose ProductName or FileDescription and CompanyName agree with an installed app's DisplayName and Publisher maps to that app." },
      { "id": "ps-onedrive-1", "type": "identity", "description": "OneDrive sync service. Its ProductName, Microsoft OneDrive Sync Service, does not match the Microsoft OneDrive entry, so the ARP comparison misses it.", "when": { "exeName": "OneDrive.Sync.Service.exe", "publisher": "Microsoft Corporation" }, "target": { "displayName": "Microsoft OneDrive", "publisher": "Microsoft Corporation" } },
